{
  "name": "dami-centro-inteligente",
  "version": "1.0.0",
  "description": "Centro de Monitoreo Inteligente DAMI. Sistema integral de monitoreo e inteligencia en tiempo real con IA avanzada.",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"cd backend && python server.py\" \"cd frontend && yarn start\"",
    "build": "cd frontend && yarn build",
    "start": "cd backend && python server.py",
    "install-all": "cd backend && pip install -r requirements.txt && cd ../frontend && yarn install",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "keywords": [
    "political-intelligence",
    "real-time-monitoring",
    "AI-analytics",
    "social-media-monitoring",
    "political-analysis",
    "dashboard",
    "fastapi",
    "react",
    "mongodb",
    "chatbot"
  ],
  "author": "DAMI Development Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dami-center/dami-centro-inteligente.git"
  },
  "bugs": {
    "url": "https://github.com/dami-center/dami-centro-inteligente/issues"
  },
  "homepage": "https://dami-center.github.io/dami-centro-inteligente",
  "engines": {
    "node": ">=18.0.0",
    "python": ">=3.11.0"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  },
  "devDependencies": {},
  "workspaces": [
    "frontend",
    "backend"
  ],
  "config": {
    "mongodb_url": "mongodb://localhost:27017",
    "frontend_port": 3000,
    "backend_port": 8001
  },
  "contributors": [
    {
      "name": "DAMI AI Team",
      "email": "ai@dami-center.com",
      "role": "AI Development"
    },
    {
      "name": "DAMI Frontend Team", 
      "email": "frontend@dami-center.com",
      "role": "React Development"
    },
    {
      "name": "DAMI Backend Team",
      "email": "backend@dami-center.com", 
      "role": "FastAPI Development"
    }
  ]
}